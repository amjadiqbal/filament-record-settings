{
    "name": "amjadiqbal/filament-record-settings",
    "description": "Edit per-record settings in Filament 4 and 5: per-user, per-team and per-tenant preferences from a settings page, a modal action or a resource form. Works with glorand/laravel-model-settings or a plain JSON column.",
    "keywords": [
        "filament",
        "filament-plugin",
        "filamentphp",
        "laravel",
        "settings",
        "model-settings",
        "user-settings",
        "user-preferences",
        "tenant-settings",
        "preferences"
    ],
    "homepage": "https://amjad.com.pk/filament/plugins/filament-record-settings",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/filament-record-settings/issues",
        "source": "https://github.com/amjadiqbal/filament-record-settings",
        "docs": "https://amjad.com.pk/filament/plugins/filament-record-settings"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "glorand/laravel-model-settings": "^8.0|^9.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "glorand/laravel-model-settings": "Store settings in a JSON field, a settings table, Redis or the cache (^8.0 or ^9.0)."
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\FilamentRecordSettings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\FilamentRecordSettings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\FilamentRecordSettings\\FilamentRecordSettingsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
